{
  "manifest_version": 3,
  "name": "Darija Translator",
  "version": "1.0.0",
  "description": "Translate selected text to Moroccan Darija via right-click or side panel.",

  "permissions": [
    "contextMenus",
    "sidePanel",
    "activeTab",
    "storage",
    "tts"
  ],

  "host_permissions": [
    "http://localhost:8080/*",
    "https://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "action": {
    "default_title": "Open Darija Translator",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
