<?php
/**
 * Darija Translator — PHP Client
 *
 * A simple web form that calls the Jakarta REST endpoint.
 * Run with:   php -S localhost:9090
 * Then open:  http://localhost:9090
 */

define('API_URL',  'http://localhost:8080/darija-translator/api/translate');
define('API_USER', 'apiuser');
define('API_PASS', 'secret');

$translation = '';
$error       = '';
$inputText   = '';
$sourceLang  = 'English';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $inputText  = trim($_POST['text']      ?? '');
    $sourceLang = trim($_POST['sourceLang'] ?? 'English');

    if ($inputText === '') {
        $error = 'Please enter some text to translate.';
    } else {
        $translation = callTranslatorApi($inputText, $sourceLang);
    }
}

/**
 * Call the REST endpoint using cURL with Basic Authentication.
 */
function callTranslatorApi(string $text, string $sourceLang): string {
    $payload = json_encode(['text' => $text, 'sourceLang' => $sourceLang]);

    $ch = curl_init(API_URL);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_POST           => true,
        CURLOPT_POSTFIELDS     => $payload,
        CURLOPT_HTTPHEADER     => ['Content-Type: application/json'],
        CURLOPT_USERPWD        => API_USER . ':' . API_PASS,
        CURLOPT_TIMEOUT        => 30,
        CURLOPT_SSL_VERIFYPEER => false,  // set to true in production
    ]);

    $response = curl_exec($ch);
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $curlError = curl_error($ch);
    curl_close($ch);

    if ($curlError) {
        return 'cURL error: ' . htmlspecialchars($curlError);
    }
    if ($httpCode === 401) {
        return 'Authentication failed (HTTP 401).';
    }
    if ($httpCode !== 200) {
        return "Server error (HTTP $httpCode).";
    }

    $data = json_decode($response, true);
    return $data['translation'] ?? 'No translation returned.';
}
?>
